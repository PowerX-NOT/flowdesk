# Railway / PlanetScale environment variables reference.
# Set these in the Railway service Variables tab — do not use a local .env file.

DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_SSL=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

ALLOWED_ORIGINS=https://your-admin.example.com

APP_ENV=production
LOG_LEVEL=INFO
PORT=8000

TRUST_PROXY_HEADERS=true
# Use * so Railway internal healthchecks are not blocked
TRUSTED_HOSTS=*
