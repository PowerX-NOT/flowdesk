# Copy to .env for local development only.
# On Railway, set these in the service Variables tab — never commit real secrets.

# MySQL — Railway injects MYSQL* vars; map to DATABASE_URL in Railway dashboard:
# mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE
# PlanetScale example (SSL required):
# mysql+pymysql://user:pass@aws.connect.psdb.cloud/dbname?ssl_ca=/etc/ssl/certs/ca-certificates.crt
DATABASE_URL=mysql+pymysql://taskuser:CHANGE_ME@your-mysql-host.railway.app:3306/employee_tasks

# Enable SSL for PlanetScale / managed MySQL (set true on Railway if provider requires it)
DATABASE_SSL=false

# Connection pool (production)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# JWT — REQUIRED in production (min 32 chars)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — comma-separated HTTPS origins (admin web panels, etc.)
# Mobile apps do not send Origin; leave empty or add your web admin URL.
ALLOWED_ORIGINS=https://your-admin.example.com

# production | development
APP_ENV=production

# Logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Server port (Railway sets PORT automatically)
PORT=8000

# Trust X-Forwarded-Proto from Railway reverse proxy
TRUST_PROXY_HEADERS=true

# Comma-separated hosts, or * for Railway dynamic domains
TRUSTED_HOSTS=*.up.railway.app,your-app.up.railway.app
