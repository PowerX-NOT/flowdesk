# Railway API service variables — set in Railway dashboard (not a placeholder DATABASE_URL).

# Option A (recommended): Link MySQL service to API — Railway injects MYSQLHOST, etc.
# Do NOT set DATABASE_URL, or delete the placeholder if you added one.

# Option B: Single variable reference in Railway:
# DATABASE_URL = ${{MySQL.DATABASE_URL}}   (use Railway "Reference" picker)

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

DATABASE_SSL=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

ALLOWED_ORIGINS=
APP_ENV=production
LOG_LEVEL=INFO

TRUST_PROXY_HEADERS=true
TRUSTED_HOSTS=*
